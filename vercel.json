{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-serie",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron-report",
      "schedule": "0 22 * * *"
    }
  ]
}