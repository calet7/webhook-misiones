{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/cron-serie.js": {
      "maxDuration": 60
    },
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-serie",
      "schedule": "0 14 * * *"
    }
  ]
}